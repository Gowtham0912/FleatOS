# ── PostgreSQL connection ──────────────────────────────────────────────────────
# asyncpg driver format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://fleet_user:fleet_pass@localhost:5432/fleet_db

# ── App settings ───────────────────────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── CORS: add your frontend origin here if different ──────────────────────────
# ALLOWED_ORIGINS=["http://localhost:5173"]

# Google Maps API Key for Backend Web Services
GOOGLE_MAPS_API_KEY=your_server_api_key_here
